DB_HOST=localhost
DB_NAME=biblioteca_pdf
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

APP_ENV=local
APP_DEBUG=true

# URL onde a aplicação responde. Usada pela suíte Cypress como baseUrl.
# Ajuste para o caminho em que você instalou o projeto.
APP_URL=http://localhost/meus_livros/

# Cadastro público (e-mail, senha e WhatsApp). false = só o administrador cria contas.
# CADASTRO_ABERTO=true

# Troca 1 por 1 do Assinante (opcional; desligada por padrão): ele só lê o que enviou e o que escolher em "Explorar acervo".
# ASSINANTE_TROCA=true
# ASSINANTE_LIVROS_INICIAIS=3

# Teste grátis e mensalidade: o pagamento é por PIX, combinado com o suporte no WhatsApp.
# SUPORTE_WHATSAPP=5585986920243   # número do suporte (com 55 e DDD, só dígitos)
# ASSINATURA_EXIGIDA=false         # true = quem terminou o teste só vê a tela /assinatura
